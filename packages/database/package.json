{
  "name": "@famir/database",
  "type": "module",
  "version": "0.0.6",
  "description": "Database connector, manager, repositories and models",
  "keywords": [
    "famir",
    "fake-mirrors",
    "reverse-proxy"
  ],
  "author": "Dmitry Krutikov <d.krutikov@gmail.com>",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "prettier -w \"src/**/*.ts\" README.md",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test dist/**/*.test.js",
    "stylua": "stylua redis-functions",
    "selene": "selene redis-functions",
    "prebuild": "node generate-redis-functions.js",
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitnoize/famir.git",
    "directory": "packages/database"
  },
  "bugs": {
    "url": "https://github.com/bitnoize/famir/issues"
  },
  "homepage": "https://docs.fake-mirrors.net",
  "dependencies": {
    "@famir/common": "*",
    "@famir/config": "*",
    "@famir/http-proto": "*",
    "@famir/logger": "*",
    "@famir/validator": "*",
    "redis": "^6.2.1"
  }
}
