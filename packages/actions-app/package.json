{
  "name": "@famir/actions-app",
  "type": "module",
  "version": "0.0.4",
  "description": "Actions application",
  "keywords": [
    "famir",
    "fake-mirrors",
    "reverse-proxy"
  ],
  "author": "Dmitry Krutikov <d.krutikov@gmail.com>",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "prettier -w \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test dist/**/*.test.js",
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitnoize/famir.git",
    "directory": "packages/actions-app"
  },
  "bugs": {
    "url": "https://github.com/bitnoize/famir/issues"
  },
  "homepage": "https://fake-mirrors.net",
  "dependencies": {
    "@famir/common": "*",
    "@famir/validator": "*",
    "@famir/config": "*",
    "@famir/logger": "*",
    "@famir/database": "*",
    "@famir/storage": "*",
    "@famir/producer": "*",
    "@famir/consumer": "*"
  }
}
