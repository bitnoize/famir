{
  "name": "@famir/http-tools",
  "type": "module",
  "version": "0.0.7",
  "description": "HTTP tools",
  "keywords": [
    "famir",
    "fake-mirrors",
    "reverse-proxy"
  ],
  "author": "Dmitry Krutikov <d.krutikov@gmail.com>",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "prettier -w \"src/**/*.ts\" README.md",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test dist/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage dist/**/*.test.js",
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitnoize/famir.git",
    "directory": "packages/http-tools"
  },
  "bugs": {
    "url": "https://github.com/bitnoize/famir/issues"
  },
  "homepage": "https://docs.fake-mirrors.net",
  "dependencies": {
    "@famir/common": "*",
    "@famir/http-proto": "*",
    "cheerio": "^1.2.0",
    "content-type": "^3.0.0",
    "iconv-lite": "^0.7.3",
    "isbot": "^5.2.1",
    "qs": "^6.15.3",
    "tough-cookie": "^6.0.2",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/content-type": "^1.1.9",
    "@types/qs": "^6.15.0"
  }
}
