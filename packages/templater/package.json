{
  "name": "@famir/templater",
  "type": "module",
  "version": "0.0.5",
  "description": "Lightweight template rendering tool",
  "keywords": [
    "famir",
    "fake-mirrors",
    "reverse-proxy"
  ],
  "author": "Dmitry Krutikov <d.krutikov@gmail.com>",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "prettier -w \"src/**/*.ts\" README.md",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test dist/**/*.test.js",
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitnoize/famir.git",
    "directory": "packages/templater"
  },
  "bugs": {
    "url": "https://github.com/bitnoize/famir/issues"
  },
  "homepage": "https://docs.fake-mirrors.net",
  "dependencies": {
    "@famir/common": "*",
    "eta": "^4.6.0"
  }
}
